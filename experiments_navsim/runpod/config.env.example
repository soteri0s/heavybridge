# =============================================================================
# config.env -- every knob of a RunPod run. Copy to config.env and edit:
#     cp config.env.example config.env
# launch.sh ships it to the pod; remote_run.sh and train_stage.sh source it.
# The navtest_*.sh drivers overwrite the relevant keys per variant (setk).
# NEVER commit a config.env that contains secrets.
# =============================================================================

# ---- SSH / remote layout ----------------------------------------------------
REMOTE_WORKDIR="/workspace/mc"          # where the code + repos live on the pod
SSH_USER="root"

# ---- Credentials -------------------------------------------------------------
# HF_TOKEN : HuggingFace token with access to the gated OpenScene/nuPlan data.
# CKPT_URL : the public DiffusionDrive checkpoint (warm start of every variant).
HF_TOKEN=""
CKPT_URL="https://huggingface.co/hustvl/DiffusionDrive/resolve/main/diffusiondrive_navsim_88p1_PDMS"

# ---- Storage -----------------------------------------------------------------
DATA_VOLUME="/workspace/data"   # persistent volume for maps + splits (or empty)
DATA_ROOT="/workspace/data"     # navtrain (~450 GB) + checkpoints
RCLONE_REMOTE=""                # optional checkpoint backup, e.g. "b2:bucket"

# ---- Repos + pins ------------------------------------------------------------
NAVSIM_REPO="https://github.com/autonomousvision/navsim"
NAVSIM_COMMIT=""
DIFFUSIONDRIVE_REPO="https://github.com/hustvl/DiffusionDrive"   # full navsim fork; used as THE devkit
DIFFUSIONDRIVE_COMMIT=""
CONFIG_YAML="config.yaml"       # relative to experiments_navsim/

# ---- Evaluation --------------------------------------------------------------
EVAL_SPLIT="navtest"            # navmini for a fast dry run
FORCED_KS="1 2 3 5 10 20"       # forced-anchor ranks written by select_forced_anchor.py
PDM_WORKER="ray_distributed"    # or single_machine_thread_pool / sequential
HB_RAY_THREADS="64"

# ---- Compute -----------------------------------------------------------------
CUDA_DEVICE="0"
OMP_NUM_THREADS="8"
HB_NUM_WORKERS="12"

# ---- HeavyBridge variant -----------------------------------------------------
# VARIANT selects the mixing law (single source of truth: the case table in
# train_stage.sh). Paper names:
#   R0full    Gaussian bridge (no mixing)
#   R3gfull   per-step tempered stable, alpha=1.8, kappa=0.956338  (proposed)
#   R1a/R1b   per-rollout Inverse-Gamma, nu=5 / nu=10 (fixed scale)
#   R2        per-rollout scene-amortized (learned) Inverse-Gamma scale
#   R2b       bounded amortized per-rollout head (control)
#   R3t ...   further screening variants, see train_stage.sh
#   UP        untouched upstream DiffusionDrive
VARIANT="R3gfull"
HB_MIXING="tempered"            # set per VARIANT by train_stage.sh / the drivers
HB_ALPHA="1.8"
HB_KAPPA="0.956338"
HB_GRID_N="20"
HB_SAMPLE_STEPS="2"             # matches the upstream NFE budget
HB_CHURN_ETA="0.5"              # varsigma_s = eta * c_{s|t}; 0 disables churn (control)
HB_KL_WEIGHT="1e-3"             # ELBO KL weight of the amortized head (R2)
HB_SEED=""                      # empty = stock seed; the _s2 replicates set 2

# ---- Training (warm start from the public checkpoint) -------------------------
HB_FINETUNE="1"
HB_FT_EPOCHS="100"              # 100 = full cosine schedule (paper); 15 = screening
HB_FT_LR="1e-4"
HB_BEV_WEIGHT="14.0"
HB_ZERO_INIT_LAM="1"
HB_SMOKE="1"                    # GPU compile-smoke of the head before the dump
